<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Donate - <%= campaign.title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <style>
    body { font-family: 'Inter', sans-serif; }
    @keyframes float { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-10px); } }
    @keyframes pulse-glow { 0%, 100% { box-shadow: 0 0 20px rgba(239, 68, 68, 0.3); } 50% { box-shadow: 0 0 40px rgba(239, 68, 68, 0.6); } }
    @keyframes heartbeat { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
    @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
    @keyframes float-up { 0% { transform: translateY(20px); opacity: 0; } 100% { transform: translateY(0); opacity: 1; } }
    .animate-float { animation: float 6s ease-in-out infinite; }
    .animate-pulse-glow { animation: pulse-glow 3s ease-in-out infinite; }
    .animate-heartbeat { animation: heartbeat 1.5s ease-in-out infinite; }
    .gradient-text { background: linear-gradient(135deg, #ef4444 0%, #f97316 50%, #eab308 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .gradient-bg { background: linear-gradient(135deg, #fef2f2 0%, #fff7ed 50%, #fefce8 100%); }
    .glass-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.8); }
    .progress-bar { background: linear-gradient(90deg, #ef4444, #f97316, #eab308); background-size: 200% 100%; animation: shimmer 2s linear infinite; }
    .donate-btn { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); transition: all 0.3s ease; }
    .donate-btn:hover { transform: translateY(-3px); box-shadow: 0 20px 40px rgba(239, 68, 68, 0.4); }
    .floating-hearts { position: absolute; width: 100%; height: 100%; pointer-events: none; overflow: hidden; }
    .heart { position: absolute; animation: float-up 3s ease-in-out infinite; opacity: 0.6; }
  </style>
</head>

<body class="gradient-bg min-h-screen text-slate-800">

<div class="floating-hearts">
  <div class="heart" style="left: 10%; animation-delay: 0s;"><svg class="w-6 h-6 text-red-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></div>
  <div class="heart" style="left: 20%; animation-delay: 1s;"><svg class="w-4 h-4 text-pink-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></div>
  <div class="heart" style="left: 70%; animation-delay: 0.5s;"><svg class="w-5 h-5 text-red-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></div>
  <div class="heart" style="left: 85%; animation-delay: 1.5s;"><svg class="w-6 h-6 text-rose-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></div>
  <div class="heart" style="left: 45%; animation-delay: 2s;"><svg class="w-4 h-4 text-red-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></div>
</div>

<nav class="glass-card shadow-lg shadow-red-500/10 px-6 py-4 flex justify-between items-center">
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 bg-gradient-to-br from-red-500 to-orange-500 rounded-xl flex items-center justify-center shadow-lg">
      <i data-lucide="heart" class="w-5 h-5 text-white animate-heartbeat"></i>
    </div>
    <h1 class="text-xl font-extrabold gradient-text">HopeBridge</h1>
  </div>
  <div class="flex items-center gap-4">
    <a href="/dashboard" class="flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-red-600 transition-colors px-4 py-2 rounded-xl hover:bg-red-50"><i data-lucide="home" class="w-4 h-4"></i>Dashboard</a>
    <a href="/campaigns/<%= campaign._id %>" class="flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-blue-600 transition-colors px-4 py-2 rounded-xl hover:bg-blue-50"><i data-lucide="arrow-left" class="w-4 h-4"></i>Back to Campaign</a>
  </div>
</nav>

<main class="relative max-w-4xl mx-auto px-6 py-12">

  <div class="glass-card rounded-3xl shadow-xl shadow-red-500/10 p-8 mb-8 border border-red-100">
    <% if (campaign.image) { %>
      <div class="w-full h-48 rounded-2xl overflow-hidden mb-6"><img src="<%= campaign.image %>" class="object-cover w-full h-full" alt="campaign image"></div>
    <% } %>
    
    <div class="text-center mb-8">
      <span class="inline-flex items-center gap-1 bg-red-100 text-red-700 text-xs font-semibold px-3 py-1 rounded-full mb-3"><i data-lucide="heart" class="w-3 h-3 animate-heartbeat"></i>Make a Difference</span>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-3"><%= campaign.title %></h2>
      <p class="text-slate-600 text-lg leading-relaxed"><%= campaign.description ? campaign.description.substring(0, 200) : 'Help us make a difference in the lives of those who need it most.' %><% if (campaign.description && campaign.description.length > 200) { %>...<% } %></p>
    </div>

    <% var raisedAmount = Number(campaign.raisedAmount || 0); var goalAmount = Number(campaign.goalAmount || 0); var percent = goalAmount > 0 ? Math.round((raisedAmount / goalAmount) * 100) : 0; %>
    
    <div class="bg-gradient-to-r from-red-50 to-orange-50 rounded-2xl p-6 mb-8">
      <div class="flex justify-between items-end mb-3">
        <div><p class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Amount Raised</p><p class="text-3xl font-bold text-red-600">₹<%= raisedAmount.toLocaleString() %></p></div>
        <div class="text-right"><p class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Goal Amount</p><p class="text-2xl font-bold text-slate-700">₹<%= goalAmount.toLocaleString() %></p></div>
      </div>
      <div class="h-4 bg-slate-200 rounded-full overflow-hidden"><div class="progress-bar h-full rounded-full" id="progressBar"></div></div>
      <p class="text-center text-sm font-semibold text-slate-600 mt-2"><%= percent %>% funded</p>
    </div>

    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 bg-gradient-to-r from-red-500 to-orange-500 text-white px-6 py-3 rounded-full shadow-lg shadow-red-500/30"><i data-lucide="sparkles" class="w-5 h-5"></i><span class="font-semibold">Your donation can change lives today!</span></div>
    </div>
  </div>

  <div class="glass-card rounded-3xl shadow-xl shadow-red-500/20 p-8 border border-red-100">
    <% if (campaign.isCompleted) { %>
      <div class="text-center py-8">
        <div class="w-20 h-20 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4"><i data-lucide="check-circle" class="w-10 h-10 text-yellow-600"></i></div>
        <h3 class="text-2xl font-bold text-slate-900 mb-2">Campaign Completed!</h3>
        <p class="text-slate-600">This campaign has been successfully completed. Thank you for your support!</p>
        <a href="/campaigns/<%= campaign._id %>" class="inline-flex items-center gap-2 mt-6 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-6 py-3 rounded-xl transition-all"><i data-lucide="arrow-left" class="w-4 h-4"></i>Back to Campaign</a>
      </div>
    <% } else { %>
      <div class="text-center mb-8">
        <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4 animate-pulse-glow"><i data-lucide="heart" class="w-8 h-8 text-red-600 animate-heartbeat"></i></div>
        <h3 class="text-2xl font-bold text-slate-900 mb-2">Make Your Donation</h3>
        <p class="text-slate-600">Every contribution counts. Be the change you want to see in the world.</p>
      </div>

      <div class="mb-6">
        <label class="block text-sm font-semibold text-slate-700 mb-3">Choose Amount</label>
        <div class="grid grid-cols-3 gap-3 mb-4">
          <button type="button" onclick="setAmount(100)" class="bg-red-50 hover:bg-red-100 text-red-700 font-semibold py-3 px-4 rounded-xl transition-all border-2 border-red-200 hover:border-red-400">₹100</button>
          <button type="button" onclick="setAmount(500)" class="bg-red-50 hover:bg-red-100 text-red-700 font-semibold py-3 px-4 rounded-xl transition-all border-2 border-red-200 hover:border-red-400">₹500</button>
          <button type="button" onclick="setAmount(1000)" class="bg-red-50 hover:bg-red-100 text-red-700 font-semibold py-3 px-4 rounded-xl transition-all border-2 border-red-200 hover:border-red-400">₹1,000</button>
        </div>
      </div>

      <form method="POST" class="space-y-6">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Enter Custom Amount</label>
          <div class="relative">
            <i data-lucide="indian-rupee" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"></i>
            <input type="number" name="amount" id="amountInput" placeholder="Enter amount" min="1" class="w-full pl-12 pr-4 py-4 bg-slate-50 border-2 border-slate-200 rounded-2xl focus:outline-none focus:border-red-500 focus:bg-white transition-all text-slate-700 text-lg" required>
          </div>
        </div>
        <button type="submit" class="donate-btn w-full flex items-center justify-center gap-3 text-white font-bold py-4 px-10 rounded-2xl shadow-xl"><i data-lucide="heart" class="w-5 h-5 animate-heartbeat"></i>Donate Now & Change Lives</button>
      </form>
      <div class="mt-6 text-center"><p class="text-sm text-slate-500 flex items-center justify-center gap-2"><i data-lucide="shield-check" class="w-4 h-4 text-green-500"></i>Your donation is secure and makes an impact</p></div>
    <% } %>
  </div>

  <div class="mt-8 text-center">
    <div class="glass-card rounded-2xl p-6 border border-red-100">
      <p class="text-slate-700 font-medium leading-relaxed"><span class="text-red-600 font-bold">Did you know?</span> Your donation of just ₹500 can provide school supplies for a child for an entire year. Together, we can create a world where everyone has the opportunity to thrive.</p>
    </div>
  </div>
</main>

<footer class="bg-white/50 backdrop-blur border-t border-slate-200 py-8 mt-12">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <p class="text-slate-500 font-medium">Made with <span class="text-red-500 animate-heartbeat">♥</span> for a better world</p>
    <p class="text-slate-400 text-sm mt-1">© 2024 HopeBridge - NGO Donation Platform</p>
  </div>
</footer>

<script>
  lucide.createIcons();
  var barWidth = "<%= percent %>%";
  document.getElementById('progressBar').style.width = barWidth;
  function setAmount(amount) { document.getElementById('amountInput').value = amount; document.getElementById('amountInput').focus(); }
</script>

</body>
</html>
