<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | NGO Donation Platform</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <style>
    body { font-family: 'Inter', sans-serif; }
    
    /* Custom Animations */
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }
    
    @keyframes pulse-glow {
      0%, 100% { box-shadow: 0 0 20px rgba(59, 130, 246, 0.3); }
      50% { box-shadow: 0 0 40px rgba(59, 130, 246, 0.6); }
    }
    
    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    
    .animate-float { animation: float 6s ease-in-out infinite; }
    .animate-pulse-glow { animation: pulse-glow 3s ease-in-out infinite; }
    
    .gradient-text {
      background: linear-gradient(135deg, #3b82f6 0%, #10b981 50%, #8b5cf6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
    }
    
    .progress-bar {
      background: linear-gradient(90deg, #3b82f6, #10b981);
      background-size: 200% 100%;
      animation: shimmer 2s linear infinite;
    }
    
    .card-hover {
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    
    .card-hover:hover {
      transform: translateY(-8px) scale(1.02);
    }
    
    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #3b82f6, #10b981); border-radius: 10px; }
  </style>
</head>

<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-emerald-50 min-h-screen text-slate-800">

<!-- Hero Header -->
<header class="relative overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute top-0 left-0 w-64 h-64 bg-blue-400/20 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-400/20 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-purple-400/20 rounded-full blur-3xl"></div>

  <nav class="relative glass-card shadow-lg shadow-blue-500/10 px-6 py-4 flex justify-between items-center">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-emerald-500 rounded-xl flex items-center justify-center shadow-lg">
        <i data-lucide="heart" class="w-6 h-6 text-white"></i>
      </div>
      <h1 class="text-2xl font-extrabold gradient-text">
        HopeBridge
      </h1>
    </div>
    <div class="flex items-center gap-4">
      <% if (user) { %>
        <span class="text-sm font-medium text-slate-600 bg-white/60 px-4 py-2 rounded-full">
          Welcome, <span class="text-blue-600 font-semibold"><%= user.name %></span>
        </span>
      <% } %>
      <a href="/logout" class="flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-red-600 transition-colors px-4 py-2 rounded-xl hover:bg-red-50">
        <i data-lucide="log-out" class="w-4 h-4"></i>
        Logout
      </a>
    </div>
  </nav>

  <!-- Hero Title Section -->
  <div class="relative max-w-7xl mx-auto px-6 py-16 md:py-24 text-center">
    <div class="inline-flex items-center gap-2 bg-white/80 backdrop-blur px-4 py-2 rounded-full shadow-md mb-6">
      <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
      <span class="text-sm font-medium text-slate-600">Making a Difference, One Campaign at a Time</span>
    </div>
    <h2 class="text-4xl md:text-6xl font-extrabold text-slate-900 mb-4 leading-tight">
      Together We Can
      <span class="gradient-text block">Change Lives</span>
    </h2>
    <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
      Connect with causes that matter. Your contribution creates ripples of positive change 
      in communities across the globe.
    </p>
  </div>
</header>

<main class="relative max-w-7xl mx-auto px-6 pb-16">

  <!-- NGO Organization Profile Card -->
  <% if (user && user.role === "ngo") { %>
  <div class="bg-white/70 backdrop-blur-xl rounded-3xl shadow-xl shadow-blue-500/10 p-8 mb-10 border border-white/50">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div class="flex items-start gap-5">
        <div class="w-20 h-20 bg-gradient-to-br from-blue-500 to-emerald-500 rounded-2xl flex items-center justify-center shadow-lg flex-shrink-0">
          <i data-lucide="building-2" class="w-10 h-10 text-white"></i>
        </div>
        <div>
          <h3 class="text-2xl font-bold text-slate-900 mb-2">
            <%= user.organizationName || "Your Organization" %>
          </h3>
          <p class="text-slate-500 max-w-xl leading-relaxed">
            <%= user.about || "Add your organization description so donors can trust your mission and understand the incredible work you do." %>
          </p>
        </div>
      </div>
      
      <div class="flex flex-wrap gap-3">
        <a href="/organization/<%= user._id %>" class="flex items-center gap-2 bg-blue-100 text-blue-700 hover:bg-blue-200 font-medium px-6 py-3 rounded-xl transition-colors">
          <i data-lucide="info" class="w-4 h-4"></i>
          About
        </a>
        <a href="/organization/<%= user._id %>/work" class="flex items-center gap-2 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-medium px-6 py-3 rounded-xl shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/50 transition-all">
          <i data-lucide="globe" class="w-4 h-4"></i>
          Our Work
        </a>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Campaign Creation Section for NGOs -->
  <% if (user && user.role === "ngo") { %>
  <div class="mb-16">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-500 rounded-xl flex items-center justify-center shadow-lg">
        <i data-lucide="plus-circle" class="w-5 h-5 text-white"></i>
      </div>
      <h2 class="text-2xl font-bold text-slate-900">Create New Campaign</h2>
    </div>

    <div class="bg-white/80 backdrop-blur-xl rounded-3xl shadow-xl shadow-purple-500/10 p-8 border border-white/50">
      <form action="/campaigns/create" method="POST" enctype="multipart/form-data" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <div class="md:col-span-2">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Campaign Title</label>
          <div class="relative">
            <i data-lucide="target" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"></i>
            <input name="title" placeholder="e.g., Clean Water for Rural Communities" 
              class="w-full pl-12 pr-4 py-4 bg-slate-50 border-2 border-slate-100 rounded-2xl focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-slate-700" required>
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Goal Amount (₹)</label>
          <div class="relative">
            <i data-lucide="indian-rupee" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"></i>
            <input type="number" name="goalAmount" placeholder="50000" 
              class="w-full pl-12 pr-4 py-4 bg-slate-50 border-2 border-slate-100 rounded-2xl focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-slate-700" required>
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Deadline</label>
          <div class="relative">
            <i data-lucide="calendar" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"></i>
            <input type="date" name="deadline" 
              class="w-full pl-12 pr-4 py-4 bg-slate-50 border-2 border-slate-100 rounded-2xl focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-slate-700" required>
          </div>
        </div>

        <div class="md:col-span-2">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Category</label>
          <div class="relative">
            <i data-lucide="tag" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"></i>
            <input name="category" placeholder="e.g., Education, Healthcare, Environment, Disaster Relief" 
              class="w-full pl-12 pr-4 py-4 bg-slate-50 border-2 border-slate-100 rounded-2xl focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-slate-700">
          </div>
        </div>

        <div class="md:col-span-2">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Campaign Image (optional)</label>
          <input type="file" name="image" accept="image/*" class="w-full">
        </div>
        <div class="md:col-span-2">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Campaign Description</label>
          <div class="relative">
            <i data-lucide="align-left" class="absolute left-4 top-4 w-5 h-5 text-slate-400"></i>
            <textarea name="description" placeholder="Tell your story. Why do you need these funds? What impact will it create?" 
              class="w-full pl-12 pr-4 py-4 bg-slate-50 border-2 border-slate-100 rounded-2xl focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-slate-700 min-h-[140px] resize-none" required></textarea>
          </div>
        </div>

        <div class="md:col-span-2 mt-2">
          <button type="submit" class="w-full md:w-auto flex items-center justify-center gap-2 bg-gradient-to-r from-blue-600 via-purple-600 to-emerald-600 hover:from-blue-700 hover:via-purple-700 hover:to-emerald-700 text-white font-bold py-4 px-10 rounded-2xl shadow-xl shadow-purple-500/30 hover:shadow-purple-500/50 transition-all transform hover:-translate-y-1">
            <i data-lucide="rocket" class="w-5 h-5"></i>
            Launch Campaign
          </button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <!-- Active Campaigns Section -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 bg-gradient-to-br from-emerald-500 to-teal-500 rounded-xl flex items-center justify-center shadow-lg animate-float">
        <i data-lucide="heart-handshake" class="w-5 h-5 text-white"></i>
      </div>
      <h2 class="text-2xl font-bold text-slate-900">Active Campaigns</h2>
      <span class="bg-emerald-100 text-emerald-700 text-sm font-semibold px-3 py-1 rounded-full">
        <%= activeCampaigns ? activeCampaigns.length : 0 %> Campaigns
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    
    <% if (activeCampaigns && activeCampaigns.length > 0) { %>
      <% activeCampaigns.forEach(function(campaign){ 
        const raisedAmount = Number(campaign.raisedAmount || 0);
        const goalAmount = Number(campaign.goalAmount || 0);
        const percent = goalAmount > 0 ? Math.round((raisedAmount / goalAmount) * 100) : 0;
        const createdById = campaign.createdBy && campaign.createdBy._id
          ? campaign.createdBy._id.toString()
          : campaign.createdBy
            ? campaign.createdBy.toString()
            : "";
        const canManageCampaign = user && user.role === "ngo" && user._id && createdById === user._id.toString();
      %>
        <div class="relative bg-white/80 backdrop-blur-xl rounded-3xl overflow-hidden shadow-lg shadow-blue-500/10 border border-white/50 card-hover group">
          
          <!-- Card Header -->
          <% if (campaign.image) { %>
            <div class="w-full h-48 overflow-hidden">
              <img src="<%= campaign.image %>" class="object-cover w-full h-full" alt="campaign image">
            </div>
          <% } %>
          <div class="bg-gradient-to-br from-blue-500 via-purple-500 to-emerald-500 p-6 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
            <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/10 rounded-full translate-y-1/2 -translate-x-1/2"></div>
            
            <span class="inline-flex items-center gap-1 bg-white/20 backdrop-blur px-3 py-1 rounded-full text-white text-xs font-semibold mb-3">
              <i data-lucide="folder" class="w-3 h-3"></i>
              <%= campaign.category || 'General' %>
            </span>
            
            <a href="/campaigns/<%= campaign._id %>" class="text-xl font-bold text-white line-clamp-2 hover:underline">
              <%= campaign.title %>
            </a>
          </div>

          <!-- Card Body -->
          <div class="p-6">
            <p class="text-slate-500 text-sm line-clamp-3 leading-relaxed mb-6">
              <%= campaign.description %>
            </p>

            <!-- Progress Section -->
            <div class="mb-4">
              <div class="flex justify-between items-end mb-2">
                <div>
                  <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Raised</p>
                  <p class="text-xl font-bold text-emerald-600">₹<%= raisedAmount.toLocaleString() %></p>
                </div>
                <div class="text-right">
                  <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Goal</p>
                  <p class="text-xl font-bold text-slate-700">₹<%= goalAmount.toLocaleString() %></p>
                </div>
              </div>
              
              <div class="h-3 bg-slate-100 rounded-full overflow-hidden">
                <div class="progress-bar h-full rounded-full" style="width: <%= Math.min(percent, 100) %>%"></div>
              </div>
              <p class="text-right text-xs font-semibold text-slate-500 mt-1"><%= percent %>% funded</p>
            </div>

            <!-- Action Buttons -->
            <div class="flex gap-2 mt-4">
              <% if (user && user.role === "donor") { %>
                <a href="/campaigns/<%= campaign._id %>" class="flex-1 flex items-center justify-center gap-2 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-semibold py-3 rounded-xl transition-all shadow-lg shadow-emerald-500/30">
                  <i data-lucide="heart" class="w-4 h-4"></i>
                  Donate Now
                </a>
              <% } else { %>
                <a href="/campaigns/<%= campaign._id %>" class="flex-1 flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-3 rounded-xl transition-all">
                  <i data-lucide="eye" class="w-4 h-4"></i>
                  View Details
                </a>
              <% } %>

              <% if (canManageCampaign) { %>
                <div class="absolute top-4 right-4 flex gap-2">
                  <a href="/campaigns/<%= campaign._id %>/edit" class="text-white bg-blue-600 hover:bg-blue-700 p-2 rounded-full shadow-lg">
                    <i data-lucide="edit-2" class="w-4 h-4"></i>
                  </a>
                  <form action="/campaigns/<%= campaign._id %>/delete" method="POST" onsubmit="return confirm('Delete this campaign?');">
                    <button type="submit" class="text-white bg-red-600 hover:bg-red-700 p-2 rounded-full shadow-lg">
                      <i data-lucide="trash" class="w-4 h-4"></i>
                    </button>
                  </form>
                </div>
              <% } %>
            </div>
            
            <% if (user && user.role === "donor") { %>
              <a href="/organization/<%= createdById %>" class="block text-center text-sm text-slate-500 hover:text-blue-600 mt-3 transition-colors">
                By <span class="font-semibold">View Organization</span>
              </a>
            <% } %>
          </div>

        </div>
      <% }) %>
    <% } else { %>
      <div class="col-span-full">
        <div class="bg-white/60 backdrop-blur-xl rounded-3xl border-2 border-dashed border-slate-300 p-12 text-center">
          <div class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <i data-lucide="inbox" class="w-10 h-10 text-slate-400"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-700 mb-2">No Campaigns Yet</h3>
          <p class="text-slate-500 max-w-md mx-auto">
            Be the first to create a campaign and start making a difference in people's lives.
          </p>
        </div>
      </div>
    <% } %>

  </div>

  <!-- Completed Campaigns Section -->
  <% if (completedCampaigns && completedCampaigns.length > 0) { %>
  <div class="mt-16">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 bg-yellow-400 rounded-xl flex items-center justify-center shadow-lg animate-pulse-glow">
        <i data-lucide="smile" class="w-5 h-5 text-white"></i>
      </div>
      <h2 class="text-2xl font-bold text-slate-900">Completed Campaigns - Happy Faces, Happy Society</h2>
      <span class="bg-yellow-100 text-yellow-700 text-sm font-semibold px-3 py-1 rounded-full">
        <%= completedCampaigns.length %> Completed
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% completedCampaigns.forEach(function(campaign){ 
        const createdById = campaign.createdBy && campaign.createdBy._id
          ? campaign.createdBy._id.toString()
          : campaign.createdBy
            ? campaign.createdBy.toString()
            : "";
        const canManageCampaign = user && user.role === "ngo" && user._id && createdById === user._id.toString();
      %>
        <div class="relative bg-white/80 backdrop-blur-xl rounded-3xl overflow-hidden shadow-lg shadow-yellow-500/10 border border-white/50 card-hover group">
          <% if (campaign.image) { %>
            <div class="w-full h-48 overflow-hidden">
              <img src="<%= campaign.image %>" class="object-cover w-full h-full" alt="campaign image">
            </div>
          <% } %>
          <% if (canManageCampaign) { %>
            <div class="absolute top-4 right-4 flex gap-2">
              <a href="/campaigns/<%= campaign._id %>/edit" class="text-white bg-blue-600 hover:bg-blue-700 p-2 rounded-full shadow-lg">
                <i data-lucide="edit-2" class="w-4 h-4"></i>
              </a>
              <form action="/campaigns/<%= campaign._id %>/delete" method="POST" onsubmit="return confirm('Delete this campaign?');">
                <button type="submit" class="text-white bg-red-600 hover:bg-red-700 p-2 rounded-full shadow-lg">
                  <i data-lucide="trash" class="w-4 h-4"></i>
                </button>
              </form>
            </div>
          <% } %>
          <div class="p-6 text-center">
            <h3 class="text-xl font-bold text-slate-900 line-clamp-2"><%= campaign.title %></h3>
            <p class="text-slate-500 text-sm mt-2 line-clamp-2"><%= campaign.description %></p>
            <div class="mt-4">
              <i data-lucide="heart" class="text-red-500 w-6 h-6 inline-block"></i>
              <span class="text-red-600 font-semibold ml-2">Goal reached. Happy Faces, Happy Society!</span>
            </div>
            <a href="/campaigns/<%= campaign._id %>" class="mt-6 inline-flex items-center gap-2 bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-3 px-6 rounded-xl transition-all">
              <i data-lucide="eye" class="w-4 h-4"></i>
              View Story
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>

</main>

<!-- Footer -->
<footer class="bg-white/50 backdrop-blur border-t border-slate-200 py-8 mt-12">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <p class="text-slate-500 font-medium">
      Made with <span class="text-red-500">♥</span> for a better world
    </p>
    <p class="text-slate-400 text-sm mt-1">© 2024 HopeBridge - NGO Donation Platform</p>
  </div>
</footer>

<script>
  // Initialize Lucide icons
  lucide.createIcons();
</script>

</body>
</html>
